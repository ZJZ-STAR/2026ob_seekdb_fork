DROP DATABASE IF EXISTS fts_score_elision;
CREATE DATABASE fts_score_elision;
USE fts_score_elision;
CREATE TABLE docs(id INT PRIMARY KEY, body TEXT, FULLTEXT INDEX ft(body) WITH PARSER beng);
INSERT INTO docs VALUES (1,'database hello hello'),(2,'database audit'),
(3,'hello world'),(4,'unrelated document'),(5,''),(6,NULL);
SELECT id FROM docs WHERE MATCH(body) AGAINST('hello database') ORDER BY id;
id
1
2
3
SELECT COUNT(*),SUM(id) FROM docs WHERE MATCH(body) AGAINST('hello database');
COUNT(*)	SUM(id)
3	6
SELECT id FROM docs WHERE MATCH(body) AGAINST('hello database') AND id>1 ORDER BY id;
id
2
3
SELECT id FROM docs WHERE MATCH(body) AGAINST('hello database') ORDER BY id LIMIT 1 OFFSET 1;
id
2
SELECT id FROM docs WHERE MATCH(body) AGAINST('hello database') LIMIT 0;
id
SELECT id FROM docs WHERE MATCH(body) AGAINST('hello hello database') ORDER BY id;
id
1
2
3
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('missingunique');
COUNT(*)
0
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('the and');
COUNT(*)
0
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('');
COUNT(*)
0
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST(NULL);
COUNT(*)
0
SELECT id,ROUND(MATCH(body) AGAINST('hello database'),8) AS score
FROM docs WHERE MATCH(body) AGAINST('hello database') ORDER BY id;
id	score
1	1.82997747
2	0.87373693
3	0.87373693
SELECT id,(MATCH(body) AGAINST('hello database') IS TRUE) AS matched
FROM docs WHERE MATCH(body) AGAINST('hello database') ORDER BY id;
id	matched
1	1
2	1
3	1
SELECT id FROM docs WHERE MATCH(body) AGAINST('hello database')
ORDER BY MATCH(body) AGAINST('hello database') DESC,id;
id
1
2
3
SELECT id FROM docs WHERE MATCH(body) AGAINST('hello database')>0.25 ORDER BY id;
id
1
2
3
SELECT id FROM docs WHERE MATCH(body) AGAINST('hello database')
AND MATCH(body) AGAINST('hello database')>100 ORDER BY id;
id
SELECT id FROM docs WHERE MATCH(body) AGAINST('+database -audit' IN BOOLEAN MODE) ORDER BY id;
id
1
SELECT id FROM docs WHERE MATCH(body) AGAINST('hello database')
GROUP BY id HAVING MAX(MATCH(body) AGAINST('hello database'))>0.25 ORDER BY id;
id
1
2
3
SELECT id,ROW_NUMBER() OVER(ORDER BY MATCH(body) AGAINST('hello database') DESC,id) AS rank_id
FROM docs WHERE MATCH(body) AGAINST('hello database') ORDER BY id;
id	rank_id
1	1
2	2
3	3
PREPARE score_filter FROM 'SELECT id FROM docs WHERE MATCH(body) AGAINST(?) AND MATCH(body) AGAINST(?)>? ORDER BY id';
SET @query='hello database',@threshold=0;
EXECUTE score_filter USING @query,@query,@threshold;
id
1
2
3
SET @threshold=100;
EXECUTE score_filter USING @query,@query,@threshold;
id
DEALLOCATE PREPARE score_filter;
START TRANSACTION;
DELETE FROM docs;
ROLLBACK;
UPDATE docs SET body='replacement audit' WHERE id=1;
DELETE FROM docs WHERE id=2;
INSERT INTO docs VALUES(7,'database hello');
SELECT id FROM docs WHERE MATCH(body) AGAINST('hello database') ORDER BY id;
id
3
7
DROP DATABASE fts_score_elision;
